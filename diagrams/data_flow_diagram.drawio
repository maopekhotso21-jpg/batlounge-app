        <mxCell id="order_title" value="ORDER PROCESSING  |  Logical data flow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="700" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="order_step1" value="&lt;b&gt;1. Load reference data&lt;/b&gt;&lt;br&gt;Read active vendors and products" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="565" width="250" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="order_step2" value="&lt;b&gt;2. Validate order&lt;/b&gt;&lt;br&gt;Check product availability and quantities" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="365" y="565" width="250" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="order_step3" value="&lt;b&gt;3. Calculate totals&lt;/b&gt;&lt;br&gt;Compute line amounts and order total" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="565" width="250" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="order_step4" value="&lt;b&gt;4. Persist order&lt;/b&gt;&lt;br&gt;Write order header and order items" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="955" y="565" width="250" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="order_step5" value="&lt;b&gt;5. Update stock&lt;/b&gt;&lt;br&gt;On completion, decrement product stock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#4C1D95;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="565" width="280" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="order_flow_1" value="Validated inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4C1D95;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order_step1" target="order_step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="order_flow_2" value="Valid quantities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4C1D95;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order_step2" target="order_step3">
