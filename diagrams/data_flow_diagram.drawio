          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="order_flow_4" value="Same transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4C1D95;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="order_step4" target="order_step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="transaction_note" value="&lt;b&gt;Transaction / integrity rule&lt;/b&gt;&lt;br&gt;Perform order-header insertion, order-item insertion, and the completion-time stock update within one database transaction. Commit only if all required operations succeed; otherwise roll back. Use appropriate stock checks / locking to prevent overselling." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#334155;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="700" width="900" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="security_note" value="&lt;b&gt;Trust and validation rule&lt;/b&gt;&lt;br&gt;Never trust client-supplied totals, role claims, product status, or stock quantities. Verify permissions and recalculate totals on the server." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontColor=#334155;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="700" width="520" height="105" as="geometry"/>
        </mxCell>
